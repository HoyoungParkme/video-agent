# 복사해서 .env로 쓴다. 이름만 두고 값은 비운다 — .env는 커밋하지 않는다

# OpenAI API 키. 비워 두고 앱의 설정 화면에서 넣어도 된다 — 앱이 이 파일의 그 줄을 고친다
OPENAI_API_KEY=
# 받아쓰기 · 요약 모델. 비우면 기본값(whisper-1 · gpt-5-mini). 설정 화면에서 바꾸면 앱이 이 줄을 고친다
STT_MODEL=
TEXT_MODEL=

# DB 접속. 비우면 compose의 기본값(va)을 쓴다. 접속 주소에 그대로 들어가므로 영문 · 숫자만 쓴다(@ : / %는 안 된다)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 로컬 영상 폴더. 비우면 저장소의 inbox/. 앱은 읽기만 한다
INBOX_HOST_DIR=

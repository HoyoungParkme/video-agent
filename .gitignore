# 비밀과 사용자 데이터 — 커밋하지 않는다 (INFRA C6 · C4 · 6절)
.env
inbox/*
!inbox/.gitkeep
data/*
!data/.gitkeep

# 작업 도구
.claude/WORKLOG.md
.playwright-mcp/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/
frontend/.next-e2e/
frontend/next-env.d.ts
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.tmp/
*.tsbuildinfo
# next dev가 AI 에이전트를 알아보면 만드는 안내 파일 — 뿌리의 AGENTS.md가 그 몫이다
frontend/AGENTS.md
frontend/CLAUDE.md
